# Copy this file to .env and replace every placeholder before running local services.

POSTGRES_DB=medassist
POSTGRES_USER=medassist_app
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=8MB

REDIS_MAX_MEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_CONSOLE_PORT=9000

KEYCLOAK_ADMIN=replace-with-local-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-keycloak-password

MEDASSIST_GRPC_WORKERS=4
MEDASSIST_GRPC_MAX_CONCURRENT_RPCS=32

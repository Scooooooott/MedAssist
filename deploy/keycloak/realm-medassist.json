{
  "realm": "medassist",
  "enabled": true,
  "displayName": "MedAssist",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {"name": "CLINICIAN", "description": "Clinical review and clinical data role"},
      {"name": "RESEARCHER", "description": "Aggregate research role"},
      {"name": "ADMIN", "description": "Governance administration role"}
    ]
  },
  "clients": [
    {
      "clientId": "medassist-frontend",
